<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Lokasta's Fader</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lokasta.fader</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fader</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Fader controls the volume of playing audio and video in Chrome tabs. Tab information stays on your Mac.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Fader needs access to each app's audio to control its volume individually. Nothing is recorded or leaves your Mac.</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Lokasta. MIT License.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Fader shows your microphone's level while its panel is open. Nothing is recorded.</string>
</dict>
</plist>
